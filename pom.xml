<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ── Spring Boot parent ────────────────────────────────────────────── -->
    <!--
        SPRING BOOT 4.x UPGRADE (was 3.2.5):
        Spring Boot 3.2.x reached end of OSS support, so we moved to the latest
        stable 4.x line (4.1.0). Major-version changes that shipped with this:
          - Jackson 3 (groupId tools.jackson.core, package tools.jackson.databind)
          - Spring Security 7 (SecurityFilterChain DSL unchanged here)
          - Spring Data 2026.0 / Hibernate 7
          - Tomcat 11, Jakarta Servlet 6.1, Flyway 12 (managed by Boot BOM)
        NOTE: requires a staging deploy + smoke test before promotion (runtime
        behavior of Security 7 / Jackson 3 / Hibernate 7 is not fully covered by
        a compile-only verification).
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.resumeforge</groupId>
    <artifactId>resumeforge-ai</artifactId>
    <version>1.0.0</version>
    <name>ResumeForge AI Backend</name>
    <description>Resume generation and export API</description>
    <packaging>jar</packaging>

    <properties>
        <java.version>21</java.version>
        <!-- Library versions pinned for reproducible builds -->
        <pdfbox.version>3.0.2</pdfbox.version>
        <!-- SEC FIX: 5.2.5 is vulnerable to CVE-2025-31672 (zip duplicate-name
             entry data mismatch in poi-ooxml). Fixed in 5.4.0. -->
        <poi.version>5.4.0</poi.version>
        <jjwt.version>0.12.5</jjwt.version>
        <razorpay.version>1.4.5</razorpay.version>
        <commons-codec.version>1.17.0</commons-codec.version>
        <!--
            BOOT 4 CHANGE: Spring Boot 4.x removed spring-retry from its BOM
            (spring-retry is now community-maintained under spring-attic), so
            the version MUST be declared explicitly here. 2.0.13 is the latest
            release (Jun 2026), with no known CVEs.
        -->
        <spring-retry.version>2.0.13</spring-retry.version>
        <!--
            FIX: Lombok version must be declared explicitly here.

            Root cause of "version can neither be null, empty nor blank":
            The Spring Boot parent BOM manages Lombok's version inside
            <dependencyManagement>, which applies to <dependencies> blocks only.
            It does NOT apply to <annotationProcessorPaths><path> entries —
            those are resolved independently by maven-compiler-plugin BEFORE
            the BOM is consulted for annotation processors.

            Spring Boot 3.2.5 managed Lombok at 1.18.32; the Boot 4.1 parent
            manages a newer version via its own property. We override it here
            with an explicit pin so both the <dependency> entry and the
            <annotationProcessorPath> entry always use the exact same version,
            making it impossible for them to drift apart.
        -->
        <lombok.version>1.18.32</lombok.version>
        <!--
            FLYWAY FIX (added):
            Root cause of startup failure:
              "FlywayException: Unsupported Database: PostgreSQL 17.10"
            The Flyway version pulled in transitively by the Spring Boot 4.1.0
            BOM predates official certification for PostgreSQL 17.10 (Neon runs
            17.10). Flyway hard-checks the connected DB version against its own
            supported-version list and refuses to run migrations if it doesn't
            recognize it — which happens during ApplicationContext startup,
            before the EntityManagerFactory bean is created. That's why the
            error surfaces as a cascading BeanCreationException on
            'jpaSharedEM_entityManagerFactory' / 'userRepository' /
            'jwtAuthenticationFilter' even though those beans aren't the real
            problem.

            Fix: pin Flyway explicitly to a release with certified PostgreSQL
            17.x support, overriding whatever older version the Boot BOM
            manages. 13.1.0 is current stable as of Aug 2026.
        -->
        <flyway.version>13.1.0</flyway.version>
    </properties>

    <dependencies>

        <!-- ── Spring Boot starters ─────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- ── Database ──────────────────────────────────────────────────── -->
        <!--
            POSTGRESQL CONFIGURATION:
            Switched to PostgreSQL Driver.
            The Spring Boot BOM manages the version — no <version> needed.
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ── Flyway migrations ─────────────────────────────────────────── -->
        <!--
            POSTGRESQL CONFIGURATION:
            Flyway requires an explicit database-specific module for PostgreSQL since Flyway 10+.
            We use spring-boot-starter-flyway to activate auto-configuration,
            and add the flyway-database-postgresql module.

            FLYWAY FIX (added): both flyway-core (transitive) and
            flyway-database-postgresql are pinned to ${flyway.version} to
            override the Boot BOM's older, PostgreSQL-17.10-incompatible
            version. See the property comment above for the full explanation.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <version>${flyway.version}</version>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <version>${flyway.version}</version>
        </dependency>

        <!-- ── JWT ───────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ── PDF generation (Apache PDFBox 3.x) ───────────────────────── -->
        <!--
             FONT PACKAGING NOTE (BUILDER-02 root cause):
             DejaVuSans.ttf and DejaVuSans-Bold.ttf MUST exist at:
               src/main/resources/fonts/DejaVuSans.ttf
               src/main/resources/fonts/DejaVuSans-Bold.ttf

             The default Maven resource plugin copies everything under
             src/main/resources/** into the JAR root automatically —
             no additional <resource> configuration is required.

             Verify after build:
               jar tf target/resumeforge-ai-*.jar | grep fonts/
             Expected output:
               fonts/DejaVuSans.ttf
               fonts/DejaVuSans-Bold.ttf
        -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>

        <!-- ── DOCX generation (Apache POI) ────────────────────────────── -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi</artifactId>
            <version>${poi.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>
        <!--
            poi-ooxml depends on poi-ooxml-schemas / xmlbeans.
            Declaring poi-ooxml is sufficient; transitive deps are resolved
            automatically by Maven.
        -->

        <!-- ── Razorpay payment gateway ─────────────────────────────────── -->
        <dependency>
            <groupId>com.razorpay</groupId>
            <artifactId>razorpay-java</artifactId>
            <version>${razorpay.version}</version>
        </dependency>

        <!-- ── Apache Commons Codec (HMAC for Razorpay webhook) ─────────── -->
        <dependency>
            <groupId>commons-codec</groupId>
            <artifactId>commons-codec</artifactId>
            <version>${commons-codec.version}</version>
        </dependency>

        <!-- ── Lombok ────────────────────────────────────────────────────── -->
        <!--
            Version declared explicitly via ${lombok.version} property.
            The BOM manages this in <dependencyManagement> but being explicit
            ensures it matches the annotationProcessorPath entry below exactly.
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- ── Jackson (JSON serialization) ───────────────────────────────── -->
        <!--
            BOOT 4 / JACKSON 3 UPGRADE:
            Application code now uses Jackson 3 (groupId tools.jackson.core,
            package tools.jackson.databind). Version is managed by the Spring
            Boot 4.1.0 BOM — no <version> tag needed.
            jackson-annotations (com.fasterxml.jackson.core:jackson-annotations)
            is UNCHANGED in Jackson 3 (@JsonIgnore/@JsonInclude stay as-is) and
            arrives transitively via jackson-databind 3.
            Jackson 2 databind (com.fasterxml.jackson.core:jackson-databind) is
            still on the runtime classpath via jjwt-jackson and remains managed
            by Boot's Jackson 2 BOM — no explicit entry needed.
        -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- ── Spring Retry ──────────────────────────────────────────────── -->
        <!--
            AI-01 FIX: Required for RetryTemplate used in AiService.callOpenRouter()
            to retry transient OpenRouter 5xx / network failures.

            NOTE: We use RetryTemplate PROGRAMMATICALLY (not @Retryable annotation)
            because callOpenRouter is a private method called within the same bean.
            Spring AOP proxies only intercept calls that go through the proxy
            (i.e. calls from outside the bean). A private self-call bypasses the
            proxy entirely, making @Retryable silently do nothing.
            RetryTemplate invoked directly inside the method works correctly.

            BOOT 4 CHANGE: Spring Boot 4.x dropped spring-retry from its BOM,
            so the version is pinned explicitly via the spring-retry.version
            property (2.0.13 — latest release, no known CVEs).
        -->
        <dependency>
            <groupId>org.springframework.retry</groupId>
            <artifactId>spring-retry</artifactId>
            <version>${spring-retry.version}</version>
        </dependency>
        <!--
            spring-retry requires spring-aspects for @EnableRetry AOP support.
            Without this, @EnableRetry on AsyncConfig compiles but throws a
            ClassNotFoundException at startup.
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-aspects</artifactId>
        </dependency>

        <!-- ── Test ──────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!-- Spring Boot fat-JAR builder -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Exclude Lombok from the fat JAR at runtime -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Compiler — Java 21, enable Lombok annotation processing -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <!--
                                FIX: <version> is REQUIRED here.
                                The Spring Boot BOM does not apply to
                                <annotationProcessorPaths> entries. Without this
                                tag, maven-compiler-plugin throws:
                                "version can neither be null, empty nor blank"
                            -->
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

        </plugins>

        <!--
            Explicit resource configuration to guarantee fonts/ directory
            is always included — belt-and-suspenders for any custom Maven
            config that might restrict the default resource set.
        -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>**/*</include>
                </includes>
            </resource>
        </resources>

    </build>

</project>
