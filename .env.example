# ════════════════════════════════════════════════════
#  ResumeForge AI — Backend Environment Variables
#  Copy to .env (or set these in your host's dashboard).
#  Never commit your actual .env file or real secrets.
# ════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────
PORT=8080

# ── Database (required — no default, app will fail fast without these) ─
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/resumeforge
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_password_here

# ── JWT ───────────────────────────────────────────────
# Generate a strong random 256-bit secret, e.g.: openssl rand -base64 32
APP_JWT_SECRET=change_this_to_a_random_256_bit_secret

# ── OpenRouter (AI features) ─────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here
APP_SITE_URL=https://www.resumeforgeai.site
APP_SITE_NAME=ResumeForge AI

# ── CORS ──────────────────────────────────────────────
APP_CORS_ALLOWED_ORIGIN=https://resumeforgeai.site,https://www.resumeforgeai.site

# ── Razorpay ──────────────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_PAYMENT_LINK=your_payment_link
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── Email (Resend) ────────────────────────────────────
RESEND_API_KEY=your_resend_api_key
MAIL_FROM_EMAIL=support@resumeforgeai.site
MAIL_FROM_NAME=ResumeForge AI
CONTACT_RECEIVER_EMAIL=admin@resumeforgeai.site

# ── Frontend ──────────────────────────────────────────
APP_FRONTEND_BASE_URL=https://www.resumeforgeai.site

# ── Resume render service (Vercel serverless function in the frontend repo) ─
RENDER_SERVICE_URL=http://localhost:3000/api/render-pdf
RENDER_SERVICE_TIMEOUT_SECONDS=20
RENDER_INTERNAL_SECRET=your_shared_internal_secret
